rules_version = '2';

// ===============================================================
// Assumed Data Model — collection: `entries`
// ===============================================================
// Document ID: seed id (e.g. "entry_cairo_1") or generated "entry_<ts>_<rand>"
//
// Fields:
//   - id:           string   (optional, mirrors the document id)          [immutable]
//   - author:       string   (required, 1..80 chars)                      [immutable]
//   - text:         string   (required, 1..5000 chars)                    [immutable]
//   - feeling:      string   (optional, 0..40 chars)                      [immutable]
//   - destination:  string   (required, 'earth' | 'moon' | 'shooting-star') [immutable]
//   - locationName: string   (required, 0..120 chars)                     [immutable]
//   - lat:          number?  (optional, -90..90)                          [immutable]
//   - lng:          number?  (optional, -180..180)                        [immutable]
//   - timestamp:    string   (required, ISO 8601)                         [immutable]
//   - ownerUid:     string   (required, == creating user's uid)           [immutable]
//   - starPosition: map      (optional, {x,y,z} numbers, shooting stars)  [immutable]
//   - source:       string   (optional, 'composer' | 'import')            [immutable]
//                            (absent on legacy/seed entries — treated as 'composer')
//   - reactions:    map      (required) { notAlone:int, warmth:int, strength:int }
//
// Access model
//   - read   : any authenticated user (the app signs in anonymously on load)
//   - create : authenticated, schema-valid, ownerUid == auth.uid
//   - update : authenticated, schema stays valid, only `reactions` may change,
//              and the total reaction count may increase by exactly 1
//              (i.e. anyone may send one unit of support)
//   - delete : never
//
// Queries performed by the app:
//   - read all entries  -> query(collection('entries'), orderBy('timestamp','desc'))
//     (a plain collection read; no field filters are used)
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isAuthenticated() && data.ownerUid == request.auth.uid;
    }

    // True when the caller has a document in the `reviewers` collection
    // (keyed by uid). Reviewer docs are seeded out-of-band by the project
    // owner, so this is a read-only capability check for clients.
    function isReviewer() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/reviewers/$(request.auth.uid));
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidCount(value) {
      return value is int && value >= 0 && value <= 1000000;
    }

    function isEmptyOrValidNumber(value, min, max) {
      return value == null || (value is number && value >= min && value <= max);
    }

    function hasValidReactions(data) {
      return data.reactions is map
        && data.reactions.keys().hasAll(['notAlone', 'warmth', 'strength'])
        && isValidCount(data.reactions.notAlone)
        && isValidCount(data.reactions.warmth)
        && isValidCount(data.reactions.strength);
    }

    function totalReactions(reactions) {
      return reactions.notAlone + reactions.warmth + reactions.strength;
    }

    // Domain validator: enforced on BOTH create and update.
    function isValidEntry(data) {
      return data.keys().hasOnly([
          'id', 'author', 'text', 'feeling', 'destination',
          'locationName', 'lat', 'lng', 'timestamp', 'ownerUid',
          'starPosition', 'source', 'reactions'
        ])
        && data.keys().hasAll([
          'author', 'text', 'destination', 'locationName', 'timestamp', 'ownerUid', 'reactions'
        ])
        && data.author is string && data.author.size() > 0 && data.author.size() <= 80
        && data.text is string && data.text.size() > 0 && data.text.size() <= 5000
        && (!('feeling' in data) || (data.feeling is string && data.feeling.size() <= 40))
        && (!('source' in data) || data.source in ['composer', 'import'])
        && data.destination in ['earth', 'moon', 'shooting-star']
        && data.locationName is string && data.locationName.size() <= 120
        && (!('lat' in data) || isEmptyOrValidNumber(data.lat, -90, 90))
        && (!('lng' in data) || isEmptyOrValidNumber(data.lng, -180, 180))
        && data.timestamp is string && data.timestamp.size() >= 20 && data.timestamp.size() <= 40
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && hasValidReactions(data);
    }

    // Only `reactions` may change, and by exactly +1 in total.
    function isValidReactionIncrement() {
      return affectedKeys().hasOnly(['reactions'])
        && hasValidReactions(request.resource.data)
        && totalReactions(request.resource.data.reactions)
             == totalReactions(resource.data.reactions) + 1;
    }

    // ----- reviewRequests validators ---------------------------------
    // Shared shape check for create/update. Optional fields (countryCode,
    // response, responderUid, responderName, resolvedAt) are validated only
    // when present, so a creator doesn't have to pre-fill empty strings and a
    // reviewer may add them later.
    function hasValidReviewRequestShape(data) {
      return data.keys().hasOnly([
          'entryId', 'ownerUid', 'author', 'target', 'countryCode',
          'message', 'status', 'response', 'responderUid', 'responderName',
          'createdAt', 'resolvedAt'
        ])
        && data.keys().hasAll([
          'entryId', 'ownerUid', 'author', 'target', 'message', 'status', 'createdAt'
        ])
        && data.entryId is string && data.entryId.size() > 0 && data.entryId.size() <= 200
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.author is string && data.author.size() > 0 && data.author.size() <= 80
        && data.target in ['doctor', 'country', 'admin']
        && (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 8))
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.status in ['open', 'resolved']
        && (!('response' in data) || (data.response is string && data.response.size() <= 2000))
        && (!('responderUid' in data) || (data.responderUid is string && data.responderUid.size() <= 128))
        && (!('responderName' in data) || (data.responderName is string && data.responderName.size() <= 80))
        && data.createdAt is string && data.createdAt.size() >= 20 && data.createdAt.size() <= 40
        && (!('resolvedAt' in data) || (data.resolvedAt is string && data.resolvedAt.size() <= 40));
    }

    // Fields a reviewer may NOT touch once a request exists.
    function reviewRequestImmutableFields() {
      return ['entryId', 'ownerUid', 'author', 'target', 'countryCode', 'message', 'createdAt'];
    }

    // ===============================================================
    // Collection: entries
    // ===============================================================
    match /entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(request.resource.data) && isValidEntry(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidEntry(request.resource.data)
                    && isValidReactionIncrement()
                    && areImmutableFieldsUnchanged([
                         'id', 'author', 'text', 'feeling', 'destination',
                         'locationName', 'lat', 'lng', 'timestamp', 'ownerUid', 'starPosition',
                         'source'
                       ]);
      allow delete: if false;
    }

    // ===============================================================
    // Collection: reviewers  (seeded out-of-band by the project owner)
    // ===============================================================
    // Document ID: the reviewer's auth uid.
    //   - role: 'doctor' | 'admin'
    //
    // A signed-in client may read its OWN document only, so the UI can decide
    // whether to reveal the review queue. There are NO client writes: reviewer
    // docs are seeded via the Admin SDK / CLI, which bypasses these rules.
    match /reviewers/{reviewerUid} {
      allow get: if isAuthenticated() && request.auth.uid == reviewerUid;
      allow list: if false;
      allow write: if false;
    }

    // ===============================================================
    // Collection: reviewRequests
    // ===============================================================
    // Document ID: generated "rr_<ts>_<rand>".
    //
    // Fields:
    //   - entryId:       string  (required, 1..200)          [immutable]
    //   - ownerUid:      string  (required, == creator uid)  [immutable]
    //   - author:        string  (required, 1..80)           [immutable]
    //   - target:        string  (required, 'doctor'|'country'|'admin') [immutable]
    //   - countryCode:   string? (optional, 0..8)            [immutable]
    //   - message:       string  (required, 1..1000)         [immutable]
    //   - status:        string  (required, 'open'|'resolved')        [reviewer]
    //   - response:      string? (optional, 0..2000)                  [reviewer]
    //   - responderUid:  string? (optional, 0..128)                   [reviewer]
    //   - responderName: string? (optional, 0..80)                    [reviewer]
    //   - createdAt:     string  (required, ISO 8601)        [immutable]
    //   - resolvedAt:    string? (optional, 0..40)                    [reviewer]
    //
    // Access model
    //   - create : authenticated, ownerUid == auth.uid, shape valid
    //   - get    : the owner, or any reviewer
    //   - list   : the owner (constrained query), or any reviewer (unfiltered)
    //   - update : reviewers ONLY, limited to the reviewer-mutable fields above
    //   - delete : never
    //
    // QUERY-SHAPE TRAP (why get and list are declared separately):
    //   For a `list` operation, Firestore evaluates the rule against the QUERY,
    //   not individual documents. A rule that references `resource.data` is only
    //   satisfiable when the client's query provably constrains that field
    //   ("rules are not filters"). The reviewer queue lists EVERY request with
    //   NO filter, so a rule shaped `resource.data.ownerUid == request.auth.uid
    //   || isReviewer()` would fail for reviewers if `resource.data` were the
    //   only path. Because `isReviewer()` is independent of `resource.data`, the
    //   `list` rule below short-circuits to true for reviewers and their
    //   unfiltered query passes. The author branch still references
    //   `resource.data.ownerUid`, so the author MUST constrain their query with
    //   `where('ownerUid', '==', <own uid>)`. `get` is a single-document read,
    //   where `resource.data` is always available, so both branches work there.
    match /reviewRequests/{requestId} {
      allow get: if isReviewer()
                 || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow list: if isReviewer()
                  || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAuthenticated()
                    && hasValidReviewRequestShape(request.resource.data)
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isReviewer()
                    && hasValidReviewRequestShape(request.resource.data)
                    && areImmutableFieldsUnchanged(reviewRequestImmutableFields());
      allow delete: if false;
    }
  }
}
